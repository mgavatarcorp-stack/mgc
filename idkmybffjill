<script>
    (function(){
        // ========== CONFIGURATION ==========
        const W = 800, H = 800, CX = W/2, CY = H/2;
        const SHELLS = 5, RINGS = 7, TPR = 16;
        const GRID = 40;
        const TRAIL_LEN = 18;
        const SHELL_R = s => 45 + s * 58;
        const TILT = s => 0.30 + s * 0.03;
        const HUES = [0, 40, 90, 180, 260];
        // shell resonant frequencies (theoretical harmonics based on radius)
        const SHELL_FREQS = [110, 165, 220, 275, 330]; // Hz - like a harmonic series
        
        function iIdx(tiles, s, r, i) { 
            const modI = ((i % TPR) + TPR) % TPR;
            return tiles.find(t => t.s === s && t.r === r && t.i === modI); 
        }
        
        function makeTiles() {
            const t = [];
            for (let s = 0; s < SHELLS; s++)
                for (let r = 0; r < RINGS; r++)
                    for (let i = 0; i < TPR; i++)
                        t.push({ 
                            s, r, i, 
                            spin: Math.random() > 0.5 ? 1 : -1,
                            vLon: (Math.random()-0.5)*0.015, 
                            vLat: (Math.random()-0.5)*0.008,
                            dLon: 0, dLat: 0, 
                            energy: 0, pressure: 0,
                            trail: [],
                            // resonance tracking
                            phaseLock: 0,
                            shellResonanceGain: 0
                        });
            return t;
        }
        
        let tiles = makeTiles();
        let frameCounter = 0;
        let coneAngle = 0;
        let running = true;
        
        let params = {
            temp: 1.2, amplitude: 28, chaos: 0.20, speed: 0.9,
            freq1: 0.08, freq2: 0.11, tilt: 0.55,
            colorMode: "void", gravity: false,
            interpenetrate: true, sinews: true, ghosts: true,
            trailFade: 0.7, resonanceStrength: 0.8,
            resonanceEnabled: true, shellResonanceEnabled: true
        };
        
        // ========== AUDIO WITH RESONANCE DETECTION ==========
        let audioContext = null;
        let mediaStream = null;
        let sourceNode = null;
        let analyserNode = null;
        let isMicActive = false;
        let audioGain = 0.0;
        let dominantFreq = 110; // Hz
        let dominantMagnitude = 0;
        let resonanceLock = 0; // 0-1 how "locked" the lattice is to audio
        let audioDataArray = null;
        let timeDomainArray = null;
        let phaseHistory = [];
        let beatPhase = 0;
        
        async function initMicrophone() {
            if (audioContext && audioContext.state !== 'closed') {
                if (mediaStream) mediaStream.getTracks().forEach(t => t.stop());
                if (sourceNode) sourceNode.disconnect();
                if (analyserNode) analyserNode.disconnect();
                if (audioContext) await audioContext.close();
                isMicActive = false;
            }
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                analyserNode = audioContext.createAnalyser();
                analyserNode.fftSize = 1024;
                const bufferLength = analyserNode.frequencyBinCount;
                audioDataArray = new Uint8Array(bufferLength);
                timeDomainArray = new Uint8Array(analyserNode.fftSize);
                sourceNode = audioContext.createMediaStreamSource(stream);
                sourceNode.connect(analyserNode);
                mediaStream = stream;
                isMicActive = true;
                await audioContext.resume();
                document.getElementById('audioMicBtn').classList.add('mic-active');
                document.getElementById('audioMicBtn').innerHTML = '🎤 RESONATING';
            } catch(e) {
                console.warn("mic error", e);
                isMicActive = false;
                alert("Microphone access needed for resonant architecture.");
                document.getElementById('audioMicBtn').classList.remove('mic-active');
                document.getElementById('audioMicBtn').innerHTML = '🎤 RESONATE';
            }
        }
        
        async function closeMicrophone() {
            if (sourceNode) sourceNode.disconnect();
            if (analyserNode) analyserNode.disconnect();
            if (audioContext) await audioContext.close();
            if (mediaStream) mediaStream.getTracks().forEach(track => track.stop());
            isMicActive = false;
            audioGain = 0;
            resonanceLock = 0;
            dominantMagnitude = 0;
            document.getElementById('audioMicBtn').classList.remove('mic-active');
            document.getElementById('audioMicBtn').innerHTML = '🎤 RESONATE';
        }
        
        // detect dominant frequency from FFT
        function detectDominantFrequency() {
            if (!isMicActive || !analyserNode || !audioDataArray) return 110;
            analyserNode.getByteFrequencyData(audioDataArray);
            let maxVal = 0;
            let maxIdx = 0;
            const nyquist = audioContext.sampleRate / 2;
            for (let i = 2; i < 80; i++) { // focus on 20-800Hz range roughly
                if (audioDataArray[i] > maxVal) {
                    maxVal = audioDataArray[i];
                    maxIdx = i;
                }
            }
            if (maxVal > 30) {
                const freq = (maxIdx / analyserNode.fftSize) * audioContext.sampleRate;
                dominantMagnitude = maxVal / 255;
                return Math.min(500, Math.max(60, freq));
            }
            return dominantFreq; // hold last
        }
        
        // calculate resonance alignment between audio phase and tile lattice
        function updateResonanceAnalysis() {
            if (!isMicActive || !analyserNode) {
                resonanceLock *= 0.97;
                document.getElementById('resonanceLockSpan').innerText = (resonanceLock * 100).toFixed(0) + '%';
                document.getElementById('resonanceBar').style.width = (resonanceLock * 100) + '%';
                return;
            }
            
            const newDomFreq = detectDominantFrequency();
            dominantFreq = dominantFreq * 0.85 + newDomFreq * 0.15;
            
            // compute overall audio energy
            analyserNode.getByteFrequencyData(audioDataArray);
            let total = 0;
            for (let i = 0; i < 40; i++) total += audioDataArray[i];
            audioGain = Math.min(0.8, (total / (40 * 255)) * 1.5);
            
            // phase tracking for beat detection
            analyserNode.getByteTimeDomainData(timeDomainArray);
            let zeroCrossings = 0;
            for (let i = 1; i < timeDomainArray.length; i++) {
                if ((timeDomainArray[i-1] - 128) * (timeDomainArray[i] - 128) < 0) zeroCrossings++;
            }
            const dominantPeriod = audioContext.sampleRate / dominantFreq;
            const detectedBeatStrength = Math.min(1, zeroCrossings / (dominantPeriod * 0.5));
            
            // resonance lock: how well audio frequency aligns with shell harmonics
            let harmonicAlignment = 0;
            if (params.shellResonanceEnabled) {
                let bestAlignment = 0;
                for (let s = 0; s < SHELLS; s++) {
                    const ratio = dominantFreq / SHELL_FREQS[s];
                    const harmonicMatch = 1 - Math.min(0.5, Math.abs(Math.log(ratio) / Math.log(2)) % 1);
                    bestAlignment = Math.max(bestAlignment, harmonicMatch);
                }
                harmonicAlignment = bestAlignment;
            } else {
                harmonicAlignment = 0.5 + detectedBeatStrength * 0.3;
            }
            
            resonanceLock = resonanceLock * 0.92 + harmonicAlignment * 0.08;
            resonanceLock = Math.min(0.95, resonanceLock);
            
            document.getElementById('resonanceLockSpan').innerText = (resonanceLock * 100).toFixed(0) + '%';
            document.getElementById('resonanceBar').style.width = (resonanceLock * 100) + '%';
            document.getElementById('dominantFreqSpan').innerHTML = dominantFreq.toFixed(0);
            
            // update beat phase for rhythmic locking
            beatPhase = (beatPhase + dominantFreq / 30) % (Math.PI * 2);
        }
        
        // ========== RESONANT ISING UPDATE ==========
        // This is the key innovation: audio PUSHES spins toward coherent patterns
        function stepResonantIsing() {
            const T = Math.max(params.temp, 0.15);
            const resonanceStrength = params.resonanceEnabled ? params.resonanceStrength * resonanceLock : 0;
            
            // First, standard Ising Metropolis
            for (let k = 0; k < 12; k++) {
                const idx = Math.floor(Math.random() * tiles.length);
                const t = tiles[idx];
                const nb = [
                    iIdx(tiles, t.s, t.r, t.i-1), iIdx(tiles, t.s, t.r, t.i+1),
                    iIdx(tiles, t.s, (t.r-1+RINGS)%RINGS, t.i), iIdx(tiles, t.s, (t.r+1)%RINGS, t.i)
                ].filter(Boolean);
                const sumN = nb.reduce((a,n) => a + n.spin, 0);
                const dE = 2 * t.spin * sumN;
                if (dE < 0 || Math.random() < Math.exp(-dE/T)) t.spin *= -1;
            }
            
            // RESONANCE PUSH: audio coheres spins instead of randomizing
            if (resonanceStrength > 0.01) {
                tiles.forEach(tile => {
                    // shell-specific resonance: each shell has a natural frequency
                    let shellResonance = 0;
                    if (params.shellResonanceEnabled && isMicActive) {
                        const targetFreq = SHELL_FREQS[tile.s];
                        const ratio = dominantFreq / targetFreq;
                        // harmonic relationship (octaves, fifths)
                        const harmonicScore = Math.cos(Math.log2(ratio) * Math.PI * 2);
                        shellResonance = Math.max(0, harmonicScore) * resonanceLock;
                    }
                    
                    // rhythmic phase locking: spins align with beat
                    const beatAlignment = Math.sin(beatPhase + tile.s * 0.8) * 0.5 + 0.5;
                    
                    // neighbor coherence pressure: spins want to align with neighbors that are "in tune"
                    const neighbors = [
                        iIdx(tiles, tile.s, tile.r, tile.i-1),
                        iIdx(tiles, tile.s, tile.r, tile.i+1),
                        iIdx(tiles, tile.s, (tile.r-1+RINGS)%RINGS, tile.i)
                    ].filter(Boolean);
                    
                    let coherentNeighborSpin = 0;
                    if (neighbors.length) {
                        coherentNeighborSpin = neighbors.reduce((a,n) => a + n.spin, 0) / neighbors.length;
                    }
                    
                    // RESONANT FIELD: pushes spin toward coherent values based on audio
                    let targetSpin = coherentNeighborSpin; // default: align with neighbors
                    
                    if (shellResonance > 0.2) {
                        // shell harmonics want DOMAIN formation (all same sign in shell)
                        const shellAvg = tiles.filter(t => t.s === tile.s).reduce((a,t) => a + t.spin, 0) / (RINGS * TPR);
                        targetSpin = targetSpin * 0.6 + Math.sign(shellAvg) * 0.4;
                    }
                    
                    if (beatAlignment > 0.7) {
                        // beat wants to FLIP spins in waves
                        const beatFlip = Math.sin(beatPhase * 2 + tile.i * 0.3) > 0 ? 1 : -1;
                        targetSpin = targetSpin * 0.7 + beatFlip * 0.3;
                    }
                    
                    // apply resonant force (reduces entropy, creates structure)
                    const resonanceForce = resonanceStrength * (0.5 + shellResonance * 0.5) * audioGain;
                    if (Math.random() < resonanceForce * 0.3) {
                        if (targetSpin > 0.3) tile.spin = 1;
                        else if (targetSpin < -0.3) tile.spin = -1;
                        // else leave as is — resonance doesn't force, it nudges
                    }
                    
                    // track resonance gain for visualization
                    tile.shellResonanceGain = shellResonance;
                    tile.phaseLock = beatAlignment;
                });
            }
            
            // Velocity and pressure update (same as before)
            tiles.forEach(t => {
                const right = iIdx(tiles, t.s, t.r, t.i+1);
                const up = iIdx(tiles, t.s, (t.r+1)%RINGS, t.i);
                const dLon = right ? (right.spin - t.spin) * 0.008 : 0;
                const dLat = up ? (up.spin - t.spin) * 0.006 : 0;
                t.pressure = Math.abs(dLon) + Math.abs(dLat);
                // resonance adds pressure when locked (visible as glow)
                if (resonanceLock > 0.5) t.pressure += resonanceLock * 0.08;
                
                t.vLon = (t.vLon + dLon) * 0.92;
                t.vLat = (t.vLat + dLat) * 0.92;
                t.vLon = Math.max(-0.06, Math.min(0.06, t.vLon));
                t.vLat = Math.max(-0.04, Math.min(0.04, t.vLat));
                t.dLon = (t.dLon + t.vLon + Math.PI*2) % (Math.PI*2);
                t.dLat = Math.max(-0.4, Math.min(0.4, t.dLat + t.vLat));
                
                const pos = getTilePos(t);
                t.trail.push({ px: pos.px, py: pos.py, spin: t.spin });
                if (t.trail.length > TRAIL_LEN) t.trail.shift();
            });
            
            if (params.gravity) {
                for (let s = 1; s < SHELLS; s++) {
                    const inner = tiles.filter(t => t.s === s-1);
                    const outer = tiles.filter(t => t.s === s);
                    if (inner.length) {
                        const iMag = inner.reduce((a,t) => a + t.spin, 0) / inner.length;
                        outer.forEach(t => { t.vLon += iMag * 0.0006; });
                    }
                }
            }
        }
        
        // ========== WAVE & RENDERING (similar to before, but with resonance visuals) ==========
        function waveZ(gx, gy, t) {
            const x = (gx/GRID - 0.5)*2, y = (gy/GRID - 0.5)*2;
            const r = Math.sqrt(x*x + y*y);
            const resonanceMod = 1 + resonanceLock * 0.4;
            const dynamicAmp = params.amplitude * resonanceMod;
            const w1 = Math.sin(r * params.freq1 * 80 - t * params.speed * 2.1) * dynamicAmp;
            const w2 = Math.sin((x+y) * params.freq2 * 60 - t * params.speed * 1.7) * dynamicAmp * 0.55;
            const w3 = Math.sin(x*31.7 + y*17.3 + t*0.7) * Math.sin(y*23.1 - x*11.9 + t*1.1) * dynamicAmp * params.chaos;
            const env = Math.exp(-r*r*0.7);
            const edge = 1 - Math.exp(-r*r*1.8);
            return w1*env + w2*0.4 + w3*edge;
        }
        
        function proj(x3, y3, z3) { const sc = params.tilt; return { px: CX + (x3 - y3)*sc*7.2, py: CY + (x3 + y3)*sc*5.8 - z3*sc*0.85 }; }
        
        function waveColor(z, maxZ, mode) {
            const n = (z/(maxZ||1)+1)/2;
            const resGlow = resonanceLock * 30;
            if (mode === "void") return `hsl(${260 + n*60},70%,${20 + n*35 + resGlow*0.5}%)`;
            if (mode === "ocean") return `rgb(${n*40+10 + resGlow*0.8|0}, ${n*120+60 + resGlow|0}, ${n*140+100|0})`;
            if (mode === "lava") return `rgb(${n*200+55 + resGlow*1.2|0}, ${n*80 + resGlow*0.6|0}, ${(1-n)*40|0})`;
            if (mode === "aurora") return `hsl(${(n*180+160 + frameCounter*20 + resonanceLock*360)%360},80%,${30 + n*35 + resGlow*0.8}%)`;
            return `hsl(${n*240},70%,50%)`;
        }
        
        function getTilePos(tile) {
            const sR = SHELL_R(tile.s), tiltVal = TILT(tile.s);
            const ringAngle = (tile.r / RINGS) * Math.PI + tile.dLat;
            const lonAngle = (tile.i / TPR) * Math.PI * 2 + tile.dLon + coneAngle * (1 + tile.s * 0.12);
            const rY = Math.cos(Math.max(0.05, Math.min(Math.PI-0.05, ringAngle)));
            const rS = Math.sin(Math.max(0.05, Math.min(Math.PI-0.05, ringAngle)));
            const projR = sR * rS;
            let waveOffset = 0;
            if (params.interpenetrate) {
                const nx = (Math.cos(lonAngle) * projR / (GRID*7.2) + 0.5) * GRID;
                const ny = (Math.sin(lonAngle) * projR * tiltVal / (GRID*5.8) + 0.5) * GRID;
                waveOffset = waveZ(nx, ny, frameCounter) * 0.22;
            }
            const px = CX + Math.cos(lonAngle) * projR;
            const py = CY + rY * sR * tiltVal * (-2.4) + Math.sin(lonAngle) * projR * tiltVal + waveOffset * 14;
            return { px, py, scale: rS, depth: rY + tile.s * 0.01 };
        }
        
        // rendering function (abbreviated but complete)
        const canvas = document.getElementById('spheraCanvas');
        const ctx = canvas.getContext('2d');
        
        function render() {
            ctx.clearRect(0, 0, W, H);
            ctx.fillStyle = "#020008";
            ctx.fillRect(0, 0, W, H);
            
            const tFrame = frameCounter;
            const zGrid = [];
            let maxZ = 1;
            for (let gy = 0; gy <= GRID; gy++) {
                zGrid[gy] = [];
                for (let gx = 0; gx <= GRID; gx++) {
                    const z = waveZ(gx, gy, tFrame);
                    zGrid[gy][gx] = { x3: (gx-GRID/2)*1.0, y3: (gy-GRID/2)*1.0, z };
                    if (Math.abs(z) > maxZ) maxZ = Math.abs(z);
                }
            }
            
            const depthItems = [];
            for (let gy = 0; gy < GRID; gy++) {
                for (let gx = 0; gx < GRID; gx++) {
                    const tl = zGrid[gy][gx], tr = zGrid[gy][gx+1];
                    const bl = zGrid[gy+1][gx], br = zGrid[gy+1][gx+1];
                    const avgZ = (tl.z + tr.z + bl.z + br.z) / 4;
                    const ptl = proj(tl.x3, tl.y3, tl.z), ptr = proj(tr.x3, tr.y3, tr.z);
                    const pbl = proj(bl.x3, bl.y3, bl.z), pbr = proj(br.x3, br.y3, br.z);
                    const dx1 = ptr.px - ptl.px, dy1 = ptr.py - ptl.py;
                    const dx2 = pbl.px - ptl.px, dy2 = pbl.py - ptl.py;
                    if (dx1*dy2 - dy1*dx2 > 0) continue;
                    depthItems.push({ type: "quad", depthY: (ptl.py+ptr.py+pbl.py+pbr.py)/4, avgZ, maxZ, ptl, ptr, pbl, pbr, mode: params.colorMode });
                }
            }
            
            const tileData = tiles.map(tile => ({ tile, pos: getTilePos(tile) }));
            tileData.forEach(td => depthItems.push({ type: "tile", depthY: td.pos.py + td.tile.s * 2, tile: td.tile, pos: td.pos }));
            depthItems.sort((a,b) => a.depthY - b.depthY);
            
            // GHOST TRAILS with resonance brightness
            if (params.ghosts) {
                tiles.forEach(tile => {
                    const trail = tile.trail;
                    if (trail.length < 2) return;
                    const hue = HUES[tile.s];
                    const fade = params.trailFade;
                    const resBoost = tile.shellResonanceGain * resonanceLock;
                    for (let k = 1; k < trail.length; k++) {
                        const alpha = ((k / trail.length) * 0.5) * fade + resBoost * 0.2;
                        const prev = trail[k-1], curr = trail[k];
                        ctx.beginPath();
                        ctx.moveTo(prev.px, prev.py);
                        ctx.lineTo(curr.px, curr.py);
                        ctx.strokeStyle = `hsla(${hue},80%,${curr.spin===1?65:38}%,${Math.min(0.6, alpha)})`;
                        ctx.lineWidth = 0.8 + resonanceLock * 1.2;
                        ctx.stroke();
                    }
                });
            }
            
            // SINEWS with resonance thickness
            if (params.sinews) {
                const depthLvl = 2;
                tiles.forEach(tile => {
                    const posA = getTilePos(tile);
                    if (posA.scale < 0.03) return;
                    const hue = HUES[tile.s];
                    for (let d = 1; d <= depthLvl; d++) {
                        const lonNb = iIdx(tiles, tile.s, tile.r, tile.i + d);
                        const latNb = iIdx(tiles, tile.s, (tile.r + d) % RINGS, tile.i);
                        [lonNb, latNb].forEach(nb => {
                            if (!nb) return;
                            const posB = getTilePos(nb);
                            if (posB.scale < 0.03) return;
                            const agreement = tile.spin === nb.spin;
                            const resonanceBonus = (tile.shellResonanceGain + nb.shellResonanceGain) * resonanceLock * 0.5;
                            const alpha = agreement ? 0.12 + resonanceBonus : 0.04 + resonanceBonus * 0.5;
                            if (alpha < 0.01) return;
                            const mx = (posA.px + posB.px)/2, my = (posA.py + posB.py)/2;
                            const dx = posB.px - posA.px, dy = posB.py - posA.py;
                            const len = Math.hypot(dx, dy) || 1;
                            const bulgeMag = (resonanceBonus * 20 + 5) * (agreement ? 1 : -0.5);
                            const perpX = -dy/len, perpY = dx/len;
                            ctx.beginPath();
                            ctx.moveTo(posA.px, posA.py);
                            ctx.quadraticCurveTo(mx + perpX * bulgeMag, my + perpY * bulgeMag, posB.px, posB.py);
                            ctx.strokeStyle = `hsla(${hue},${agreement?70:44}%,${agreement?60:55}%,${Math.min(0.5, alpha)})`;
                            ctx.lineWidth = agreement ? 0.5 + resonanceLock * 0.8 : 0.3 + resonanceLock * 0.4;
                            ctx.stroke();
                        });
                    }
                });
            }
            
            // DRAW TILES with resonance glow
            depthItems.forEach(item => {
                if (item.type === "quad") {
                    const { ptl, ptr, pbl, pbr, avgZ, maxZ, mode } = item;
                    const col = waveColor(avgZ, maxZ, mode);
                    ctx.beginPath();
                    ctx.moveTo(ptl.px, ptl.py); ctx.lineTo(ptr.px, ptr.py);
                    ctx.lineTo(pbr.px, pbr.py); ctx.lineTo(pbl.px, pbl.py);
                    ctx.closePath();
                    ctx.fillStyle = col;
                    ctx.globalAlpha = 0.5 + Math.abs(avgZ)/maxZ * 0.3;
                    ctx.fill();
                    ctx.globalAlpha = 0.1;
                    ctx.strokeStyle = col;
                    ctx.lineWidth = 0.4;
                    ctx.stroke();
                    ctx.globalAlpha = 1;
                } else {
                    const { tile, pos } = item;
                    const sz = 3 + pos.scale * 7 + resonanceLock * 1.5;
                    const hue = HUES[tile.s];
                    const resGlow = tile.shellResonanceGain * resonanceLock * 40;
                    const lit = tile.spin === 1 ? 55 + resGlow : 25 + resGlow * 0.5;
                    const sat = Math.min(75 + tile.pressure * 70 + resonanceLock * 20, 100);
                    ctx.save();
                    ctx.translate(pos.px, pos.py);
                    ctx.rotate(tile.dLon * 0.5);
                    ctx.fillStyle = `hsl(${hue}, ${sat}%, ${lit}%)`;
                    ctx.strokeStyle = `hsla(${hue}, 65%, 55%, ${0.4 + resonanceLock * 0.4})`;
                    ctx.lineWidth = 0.5;
                    ctx.fillRect(-sz/2, -sz/2, sz, sz);
                    ctx.strokeRect(-sz/2, -sz/2, sz, sz);
                    ctx.restore();
                    
                    // resonance pulse in center
                    if (tile.shellResonanceGain > 0.1) {
                        ctx.beginPath();
                        ctx.arc(pos.px, pos.py, sz * 0.6 + resonanceLock * 4, 0, Math.PI*2);
                        ctx.fillStyle = `hsla(${hue}, 80%, 60%, ${tile.shellResonanceGain * resonanceLock * 0.4})`;
                        ctx.fill();
                    }
                }
            });
            
            // Resonance visualization at center
            ctx.globalAlpha = 0.3 + resonanceLock * 0.3;
            for (let i = 0; i < 3; i++) {
                const a = coneAngle + i * Math.PI/4;
                ctx.beginPath();
                ctx.moveTo(CX, CY);
                ctx.lineTo(CX + Math.cos(a) * (W * 0.3 + resonanceLock * 80), CY + Math.sin(a) * (W * 0.12 + resonanceLock * 30));
                ctx.strokeStyle = `rgba(100, 200, 255, ${0.05 + resonanceLock * 0.15})`;
                ctx.lineWidth = 1 + resonanceLock * 3;
                ctx.stroke();
            }
            ctx.globalAlpha = 1;
            
            const mag = tiles.reduce((a,t) => a + t.spin, 0) / tiles.length;
            document.getElementById('statM').innerText = mag.toFixed(3);
            document.getElementById('statFrame').innerText = Math.floor(frameCounter);
            ctx.fillStyle = "#aaaaffaa";
            ctx.font = "9px monospace";
            ctx.fillText(`M=${mag.toFixed(2)}  resonance=${resonanceLock.toFixed(2)}  domFreq=${dominantFreq.toFixed(0)}Hz`, 12, H-12);
        }
        
        // ========== ANIMATION LOOP ==========
        let lastStep = 0;
        function animate(now) {
            if (running) {
                updateResonanceAnalysis();
                if (now - lastStep > 33) {
                    stepResonantIsing();
                    coneAngle += 0.006;
                    frameCounter += 0.016 * params.speed;
                    lastStep = now;
                }
                render();
            } else {
                render();
            }
            requestAnimationFrame(animate);
        }
        
        // ========== UI BINDINGS ==========
        function bindSlider(id, key, min, max, step, displayId) {
            const slider = document.getElementById(id);
            const disp = document.getElementById(displayId);
            slider.min = min; slider.max = max; slider.step = step;
            slider.value = params[key];
            disp.innerText = params[key].toFixed(step<0.01?3:2);
            slider.addEventListener('input', (e) => {
                params[key] = parseFloat(e.target.value);
                disp.innerText = params[key].toFixed(step<0.01?3:2);
            });
        }
        
        function bindCheck(id, key) {
            const cb = document.getElementById(id);
            cb.checked = params[key];
            cb.addEventListener('change', (e) => params[key] = e.target.checked);
        }
        
        bindSlider('tempSlider', 'temp', 0.1, 3.5, 0.02, 'tempVal');
        bindSlider('ampSlider', 'amplitude', 5, 55, 1, 'ampVal');
        bindSlider('chaosSlider', 'chaos', 0, 1, 0.01, 'chaosVal');
        bindSlider('speedSlider', 'speed', 0, 2.5, 0.03, 'speedVal');
        bindSlider('freq1Slider', 'freq1', 0.02, 0.3, 0.003, 'freq1Val');
        bindSlider('tiltSlider', 'tilt', 0.3, 0.85, 0.005, 'tiltVal');
        bindSlider('resonanceStrength', 'resonanceStrength', 0, 1.5, 0.02, 'resVal');
        bindSlider('trailFadeSlider', 'trailFade', 0.2, 1, 0.02, 'trailFadeVal');
        bindCheck('resonanceCheck', 'resonanceEnabled');
        bindCheck('shellResonanceCheck', 'shellResonanceEnabled');
        bindCheck('gravityCheck', 'gravity');
        bindCheck('sinewsCheck', 'sinews');
        bindCheck('ghostsCheck', 'ghosts');
        
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                params.colorMode = btn.getAttribute('data-mode');
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });
        document.querySelector('.mode-btn[data-mode="void"]').classList.add('active');
        
        document.getElementById('resetTilesBtn').addEventListener('click', () => { tiles = makeTiles(); });
        const runBtn = document.getElementById('runPauseBtn');
        runBtn.addEventListener('click', () => {
            running = !running;
            runBtn.innerHTML = running ? "⏸ pause" : "▶ start";
            runBtn.style.background = running ? "#1f3a2f" : "#3a2a2f";
        });
        
        const micBtn = document.getElementById('audioMicBtn');
        micBtn.addEventListener('click', async () => {
            if (isMicActive) await closeMicrophone();
            else await initMicrophone();
        });
        
        render();
        requestAnimationFrame(animate);
    })();
</script>
</body>
